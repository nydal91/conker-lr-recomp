<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.clx.recomp"
    android:versionCode="1"
    android:versionName="0.0"><!-- android/build.sh sets both from git -->

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <!-- The game folder (/sdcard/ConkerLR) and the logs (Download/ConkerLR-logs). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- SDL: rumble, USB and Bluetooth gamepads. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:label="Conker LR"
        android:icon="@drawable/icon"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:appCategory="game"
        android:extractNativeLibs="true"
        android:largeHeap="true">

        <!-- simpleperf from adb can attach to a release build (CPU profiles). -->
        <profileable android:shell="true" />

        <!-- Game Mode: Performance can be picked for the game (res/xml/game_mode_config.xml). -->
        <meta-data android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".ClxLauncher"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ClxActivity"
            android:process=":game"
            android:exported="false"
            android:label="Conker LR"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true" />
    </application>
</manifest>
